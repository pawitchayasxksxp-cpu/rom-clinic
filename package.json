{
  "name": "rom-clinic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:connections": "node --conditions=react-server --import tsx scripts/check-connections.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --conditions=react-server --import tsx scripts/setup-admin.ts --migrate-only",
    "setup:admin": "node --conditions=react-server --import tsx scripts/setup-admin.ts",
    "test:e2e": "playwright test",
    "db:migrate:patients": "node --conditions=react-server --import tsx scripts/migrate-patients.ts",
    "test:patients": "node --import tsx --test tests/unit/patient-validation.test.ts && node --conditions=react-server --import tsx scripts/test-patients.ts"
  },
  "dependencies": {
    "@next/env": "^16.4.5",
    "@vercel/functions": "^3.10.6",
    "better-auth": "^1.7.16",
    "cloudinary": "^2.11.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
