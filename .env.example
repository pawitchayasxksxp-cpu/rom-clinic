# Server-only credentials. Copy to .env and replace placeholders.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Optional override; Supabase pooler uses the bundled certs/supabase-ca.crt.
DATABASE_SSL_CA_PATH=

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=rom-clinic

# Required on Vercel: generate once and keep the same secret across deployments.
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
# Set your exact deployed origin on Vercel; localhost is for local development.
BETTER_AUTH_URL=http://localhost:3000

# Local setup only. Never expose these as NEXT_PUBLIC_ variables.
ADMIN_EMAIL=admin@romclinic.local
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_OF_AT_LEAST_8_CHARACTERS
